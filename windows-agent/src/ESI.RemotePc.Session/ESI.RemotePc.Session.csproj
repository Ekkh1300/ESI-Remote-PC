<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Esi.Session</RootNamespace>
    <AssemblyName>ESI.RemotePc.Session</AssemblyName>

    <!--
      Self-contained single file, for the same reason the agent is: the session helper is
      launched by the Windows SCM (or by a logon task) on machines the user knows nothing
      about, and a missing shared runtime must not turn a working PC into a broken one.
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!--
      The product's mark, embedded in this executable so the tray icon can read it back out
      (D74: the tray showed SystemIcons.Application - the blank page Windows draws for a
      program with no icon of its own - while the shortcuts to this very binary carried the
      real one).

      The file is release\esi.ico rather than one inside this project on purpose: it is the
      single image in the repository, and the installer points at the same path for its
      shortcuts. A second copy inside src\ would be the start of two marks that quietly
      disagree, which is the defect this setting exists to end.
    -->
    <ApplicationIcon>..\..\..\release\esi.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The Agent.Service and the Session agent both consume the same Serilog sinks, so they
      cannot drift in how they log. The Hosting package itself is not referenced: the
      FrameworkReference below already provides it, and referencing both earns a NU1510.
    -->
    <PackageReference Include="Serilog.Sinks.File" />

    <!--
      NAudio for the phone-as-speaker path. WasapiLoopbackCapture is what captures the
      system's output audio - the same mechanism Audio Relay uses for the same job - and
      MMDeviceEnumerator is how the phone picks which device or application to listen to.

      It lives in the session agent rather than the service for the reason the screen capture
      does: audio has to be captured from the interactive session that owns the audio endpoint.
    -->
    <PackageReference Include="NAudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ESI.RemotePc.Protocol\ESI.RemotePc.Protocol.csproj" />
    <ProjectReference Include="..\ESI.RemotePc.Platform\ESI.RemotePc.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ESI.RemotePc.Tests" />
  </ItemGroup>

</Project>
