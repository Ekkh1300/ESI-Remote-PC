# Build output
[Bb]in/
[Oo]bj/
artifacts/
*.user
*.suo
.vs/
.vscode/
.idea/

# Release artifacts
#
# The installer EXE and the APK are large binaries that are reproducible from source with
# `windows-agent\build.ps1` and `iscc`. Committing 300 MB of them to a repository makes every
# clone worse for no benefit, so they live on disk in release\ and are rebuilt on demand.
release/*.exe
release/*.apk
release/*.msi

# Test output
[Tt]est[Rr]esult*/
*.trx
*.coverage
coverage*.xml
coverage*.json

# Scratch output from the wire probe that produced the frames `screen_wire_layout_test.dart`
# reads. It is regenerated on demand and is not part of the product; the test names it in a
# failure message so anyone hitting that knows where to get it.
_wire/

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/

# Flutter / Dart
**/android-app/**/build/
**/android-app/**/.dart_tool/
**/android-app/**/.flutter-plugins
**/android-app/**/.flutter-plugins-dependencies
**/android-app/**/.packages
**/android-app/**/.pub-cache/
**/android-app/**/.pub/
android-app/**/android/.gradle/
android-app/**/android/local.properties
android-app/**/android/app/debug/
android-app/**/android/app/profile/
android-app/**/android/app/release/
android-app/**/*.iml

# The agent's own runtime data, in case someone runs it from a source checkout
*.db
*.db-shm
*.db-wal
*.pfx
*.pem
*.key
logs/

# OS noise
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
*.lnk

# Secrets that must never be committed, under any circumstances.
# The agent's identity, TLS key and paired-device secrets all live in ProgramData at runtime;
# if any of them ever end up in a working tree, the entries above are the last line of
# defence and the leak is the first problem.
secrets.json
provisioning-secret
*.key.pem
id_ed25519

# The Android release signing key (D47).
#
# This one matters more than the entries above it, because it is not merely this project's
# secret: the APK it signs is what a user's phone treats as "ESI Remote PC". Publishing it would
# let anyone build an update that the phone accepts as ours, which is the signing key's whole
# purpose and cannot be revoked by changing a password afterwards.
#
# It was present in the working tree and *not* covered by any of the patterns above - the
# `*.key` and `*.pem` entries do not match `esi-release.jks`, and nothing excluded
# `key.properties`, which holds the two passwords in plain text.
android-app/**/android/*.jks
android-app/**/android/key.properties
android-app/**/android/*.keystore
*.jks
